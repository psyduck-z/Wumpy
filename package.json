{
  "name": "wumpy",
  "version": "0.1.0",
  "description": "A local-first AI overlay that replaces the Windows Copilot shortcut",
  "main": "./out/main/index.js",
  "author": "psyduck-z",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/check-blocks.mjs && node scripts/check-titles.mjs && node scripts/check-approval.mjs && node scripts/check-autorun.mjs && node scripts/check-history.mjs",
    "package": "npm run hook:build && electron-vite build && electron-builder --win",
    "hotkey:claim": "powershell -ExecutionPolicy Bypass -File scripts/claim-win-c.ps1",
    "hotkey:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-copilot.ps1",
    "hook:build": "dotnet publish src/hook/WumpyHook.csproj -c Release -o resources/hook",
    "hook:test": "dotnet publish src/hook/WumpyHook.csproj -c Release -o resources/hook && resources\\hook\\WumpyHook.exe --selftest",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/make-icons.mjs",
    "bench": "node scripts/bench-models.mjs",
    "check:blocks": "node scripts/check-blocks.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "check:approval": "node scripts/check-approval.mjs",
    "check:autorun": "node scripts/check-autorun.mjs",
    "check:history": "node scripts/check-history.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
